{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://candyrescuesaga.example.com/schemas/expansion-v1.json",
  "title": "Candy Rescue Saga — 50-Level Survival Expansion Schema",
  "type": "object",
  "required": ["meta", "chapters", "levels"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["projectId", "version", "baseLevelsCount", "expansionLevelsCount", "totalCampaignLevels", "nonReligiousPolicyVerified"],
      "properties": {
        "projectId": { "type": "string" },
        "version": { "type": "string" },
        "baseLevelsCount": { "type": "integer", "const": 6 },
        "expansionLevelsCount": { "type": "integer", "const": 50 },
        "totalCampaignLevels": { "type": "integer", "const": 56 },
        "nonReligiousPolicyVerified": { "type": "boolean", "const": true }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/Chapter" }
    },
    "levels": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/LevelSpec" }
    }
  },
  "$defs": {
    "Chapter": {
      "type": "object",
      "required": [
        "chapterId",
        "chapterNumber",
        "title",
        "campaignLevelRange",
        "expansionLevelRange",
        "regionalInspiration",
        "visualTheme",
        "featuredCandies",
        "introducedObstacles",
        "introducedTools",
        "featuredEnemies",
        "chapterBossId"
      ],
      "properties": {
        "chapterId": { "type": "string", "pattern": "^CHAPTER_[0-9]{2}$" },
        "chapterNumber": { "type": "integer", "minimum": 1, "maximum": 10 },
        "title": { "type": "string" },
        "campaignLevelRange": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "expansionLevelRange": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "regionalInspiration": { "type": "string" },
        "visualTheme": { "type": "object" },
        "featuredCandies": { "type": "array", "items": { "type": "string" } },
        "introducedObstacles": { "type": "array", "items": { "type": "string" } },
        "introducedTools": { "type": "array", "items": { "type": "string" } },
        "featuredEnemies": { "type": "array", "items": { "type": "string" } },
        "chapterBossId": { "type": ["string", "null"] }
      }
    },
    "LevelSpec": {
      "type": "object",
      "required": [
        "levelId",
        "expansionNumber",
        "campaignNumber",
        "chapterId",
        "levelName",
        "environmentDescription",
        "rescueStory",
        "mainObjective",
        "secondaryObjective",
        "candyMatchingRequirement",
        "survivalObstacle",
        "enemyOrThreat",
        "specialMechanics",
        "pressureConfig",
        "difficultyRating",
        "victoryCondition",
        "failureCondition",
        "rewards",
        "uniqueGameplayTwist",
        "prerequisiteLevels",
        "recommendedTools",
        "boardBlueprint"
      ]
    }
  }
}
